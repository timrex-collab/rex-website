# WebMCP-Pilot (siehe WEBMCP.md). Alle Werte sind Build-Zeit-Variablen (Vite).
# Standard = AUS. In Netlify nur im Production-Context setzen (Deploy-Previews bleiben aus).

# Nur exakt "true" aktiviert die Registrierung der Tools.
VITE_WEBMCP_ENABLED=false

# Kommagetrennte Allowlist der Origins, auf denen Tools registriert werden dürfen. Leer = aus.
VITE_WEBMCP_ORIGINS=https://www.rex-bedachung.de

# Chrome-Origin-Trial-Token (öffentlich, kein Secret). Wird nur auf der Rechner-Seite injiziert.
# Registrierung: developer.chrome.com/origintrials → "WebMCP" → Origin https://www.rex-bedachung.de
VITE_WEBMCP_OT_TOKEN=
